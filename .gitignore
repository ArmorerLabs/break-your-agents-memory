# What is committed, what is not

# Runs are outputs, not source: every run is reproducible from the committed
# lab + the committed replay cache. Keep local run folders out of the repo.
runs/

# The virtual environment
.venv/
venv/

# Python artifacts
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage

# Mem0/Qdrant local stores created during runs (all inside runs/ normally,
# listed for safety)
*.qdrant/
mem0-*.db

# OS noise
.DS_Store
Thumbs.db

# Editor noise
.idea/
*.swp

# NOTE: replay/cache.jsonl IS committed on purpose - it holds the golden
# recorded traces, so `python -m lab.run --mode replay --settings all`
# works out of the box with zero model spend. Do not ignore it.

# Live-mode recordings (real model responses captured during live runs) are
# evidence, not source: they keep growing with every live run and the run
# folders + README hold the measured results.
replay/cache-live*.jsonl
